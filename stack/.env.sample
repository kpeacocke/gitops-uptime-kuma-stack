# Portainer stack environment for Uptime Kuma

# Persistent NAS directory. Include this path in Hyper Backup and snapshots.
UPTIME_KUMA_DATA_PATH=/volume1/dkrcfg/uptime-kuma
UPTIME_KUMA_BACKUP_PATH=/volume1/dkrcfg
UPTIME_KUMA_VERSION=2.5.3
MARIADB_VERSION=11.8
UPTIME_KUMA_DB_NAME=uptime_kuma
UPTIME_KUMA_DB_USERNAME=uptime_kuma
UPTIME_KUMA_DB_PASSWORD=replace-with-a-long-random-secret
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-secret
UPTIME_KUMA_DB_POOL_MAX_CONNECTIONS=10
BACKUP_RETENTION_DAYS=30

# IANA timezone used by the container and monitor timestamps.
TZ=Australia/Sydney
